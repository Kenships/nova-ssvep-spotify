# Copy to backend/.env (or export these in your shell) before running the backend.

# --- LSL: the ONLY thing that differs between simulator and real hardware ---
# Point at the simulator's stream name for dev/demo:
LSL_STREAM_NAME=MockEEG
# On the one real-hardware day, point at the ant-neuro eego stream name instead, e.g.:
# LSL_STREAM_NAME=eego-101

# --- Signal processing ---
DETECTOR_BACKEND=psda            # "psda" (Phase 1), "cca" (Phase 2), or "fbcca" (Chen et al. 2015)
WINDOW_SEC=2.0
CONFIDENCE_THRESHOLD=0.35
BANDPASS_LOW_HZ=5.0
# 88Hz (not 40) so fbcca.py's default 7-subband filter bank (needs up to
# 88Hz -- see its docstring) isn't truncated by this shared outer filter.
# Harmless for psda/cca: both only ever read narrow bins <=24Hz regardless
# of how much wider this ceiling is set.
BANDPASS_HIGH_HZ=88.0
MAINS_NOTCH_HZ=60.0              # 60Hz in Canada

# --- Command bus ---
DWELL_SEC=0.75
REFRACTORY_SEC=1.0

# --- Occipital channel resolution ---
# Preferred 10-20 labels, in order. If the connected stream reports raw
# electrode indices instead (common for eego without a montage applied),
# set OCCIPITAL_CHANNEL_INDICES as a fallback (0-based, comma-separated).
OCCIPITAL_CHANNEL_LABELS=Oz,O1,O2,POz
OCCIPITAL_CHANNEL_INDICES=

# --- Spotify ---
# Register an app at https://developer.spotify.com/dashboard.
# In that app's settings, add a Redirect URI that EXACTLY matches
# SPOTIFY_REDIRECT_URI below (Spotify requires an exact match).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/api/spotify/callback
# Name of the Spotify Connect device to target (e.g. desktop app's device
# name on the demo machine). Leave blank to use the first available device.
SPOTIFY_DEVICE_NAME=

# One-time setup once both SPOTIFY_CLIENT_ID and SPOTIFY_CLIENT_SECRET are
# set: with the backend running, visit http://127.0.0.1:8000/api/spotify/login
# in a browser, approve access, and the refresh token gets cached to
# backend/.spotify_token_cache (gitignored). Check
# http://127.0.0.1:8000/api/spotify/status to confirm.
